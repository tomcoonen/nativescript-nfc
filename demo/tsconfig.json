{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2017",
    "declaration": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmitHelpers": true,
    "noEmitOnError": true,
    "lib": ["es2021", "dom"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["app/*"]
    },
    "moduleResolution": "node",
    "removeComments": false
  },
  "exclude": ["node_modules", "platforms", "**/*.aot.ts"]
}
